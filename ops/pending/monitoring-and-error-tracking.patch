-GLITCHTIP_DOMAIN=glitchtip.${DOMAIN}
+# --- monitoring ---
+# Uptime Kuma push monitors (http://uptime-kuma:3001/api/push/<token>), from
+# the Kuma UI behind ssh -L 3001:localhost:3001. Empty = no heartbeat.
+KUMA_PUSH_BACKUP_URL=
+KUMA_PUSH_HUEY_URL=
+# GlitchTip starts with deploy.sh once its database exists (see the glitchtip
+# comment in docker-compose.yml); compose needs these values to parse the file
+# before that. GLITCHTIP_DOMAIN is the URL the UI is opened at, scheme
+# included: the SSH tunnel, until a public route serves it.
+GLITCHTIP_DOMAIN=http://localhost:8004
 GLITCHTIP_DB_USER=glitchtip
 GLITCHTIP_DB_PASSWORD=${GLITCHTIP_DB_PASSWORD}
 GLITCHTIP_SECRET_KEY=${GLITCHTIP_SECRET_KEY}
+# Alert mail from GlitchTip, e.g. smtp+tls://<user>:<url-encoded password>@<host>:587.
+# Empty = mail only goes to the container log.
+GLITCHTIP_EMAIL_URL=
+# Backend error reporting: http://<key>@glitchtip-web:8000/<project id>, from
+# the GlitchTip project's DSN. Empty = off.
+SENTRY_DSN=
 
 # --- frontend build-time (baked into the bundle at 'docker compose build') ---
 VITE_APP_NAME=Jasmin
