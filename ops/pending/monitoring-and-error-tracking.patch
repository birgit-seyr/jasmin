diff --git a/jasmin-core/django-core/apps/notifications/tests/test_huey_heartbeat.py b/jasmin-core/django-core/apps/notifications/tests/test_huey_heartbeat.py
new file mode 100644
index 0000000..d2ef02a
--- /dev/null
+++ b/jasmin-core/django-core/apps/notifications/tests/test_huey_heartbeat.py
@@ -0,0 +1,92 @@
+"""Tests for ``apps.notifications.tasks.huey_heartbeat``.
+
+The task touches the healthcheck file and pushes "up" to the Uptime Kuma push
+URL in ``KUMA_PUSH_HUEY_URL``. The push is optional and best-effort: unset
+means no request at all, and a failing push must neither raise nor stop the
+file from being written.
+"""
+
+from __future__ import annotations
+
+import http.client
+import logging
+import urllib.error
+from unittest import mock
+
+import pytest
+
+from apps.notifications import tasks as notification_tasks
+
+PUSH_URL = "http://uptime-kuma:3001/api/push/secret-token"
+
+
+@pytest.fixture
+def heartbeat_file(tmp_path, monkeypatch):
+    path = tmp_path / "huey_heartbeat"
+    monkeypatch.setattr(notification_tasks, "_HEARTBEAT_FILE", str(path))
+    return path
+
+
+def test_no_push_when_url_unset(heartbeat_file, monkeypatch):
+    monkeypatch.delenv("KUMA_PUSH_HUEY_URL", raising=False)
+    with mock.patch("urllib.request.urlopen") as urlopen:
+        notification_tasks.huey_heartbeat.call_local()
+    urlopen.assert_not_called()
+    assert heartbeat_file.exists()
+
+
+def test_no_push_when_url_blank(heartbeat_file, monkeypatch):
+    monkeypatch.setenv("KUMA_PUSH_HUEY_URL", "  ")
+    with mock.patch("urllib.request.urlopen") as urlopen:
+        notification_tasks.huey_heartbeat.call_local()
+    urlopen.assert_not_called()
+
+
+def test_pushes_up_with_short_timeout(heartbeat_file, monkeypatch):
+    monkeypatch.setenv("KUMA_PUSH_HUEY_URL", PUSH_URL + "?status=up&msg=OK&ping=")
+    with mock.patch("urllib.request.urlopen") as urlopen:
+        notification_tasks.huey_heartbeat.call_local()
+    urlopen.assert_called_once()
+    (url,), kwargs = urlopen.call_args
+    assert url == PUSH_URL + "?status=up&msg=OK"
+    assert kwargs["timeout"] <= 10
+    assert heartbeat_file.exists()
+
+
+def test_non_http_url_is_not_requested(heartbeat_file, monkeypatch):
+    monkeypatch.setenv("KUMA_PUSH_HUEY_URL", "file:///etc/passwd")
+    with mock.patch("urllib.request.urlopen") as urlopen:
+        notification_tasks.huey_heartbeat.call_local()
+    urlopen.assert_not_called()
+
+
+@pytest.mark.parametrize(
+    "error",
+    [
+        urllib.error.URLError("connection refused"),
+        urllib.error.HTTPError(PUSH_URL, 404, "Not Found", None, None),
+        TimeoutError("timed out"),
+        http.client.BadStatusLine("garbage"),
+        ValueError("bad url"),
+    ],
+)
+def test_failed_push_does_not_raise(heartbeat_file, monkeypatch, caplog, error):
+    monkeypatch.setenv("KUMA_PUSH_HUEY_URL", PUSH_URL)
+    with (
+        mock.patch("urllib.request.urlopen", side_effect=error),
+        caplog.at_level(logging.WARNING, logger="tasks"),
+    ):
+        notification_tasks.huey_heartbeat.call_local()
+    assert heartbeat_file.exists()
+    assert "push_failed" in caplog.text
+    assert "secret-token" not in caplog.text
+
+
+def test_push_still_runs_when_file_write_fails(tmp_path, monkeypatch):
+    monkeypatch.setattr(
+        notification_tasks, "_HEARTBEAT_FILE", str(tmp_path / "missing" / "beat")
+    )
+    monkeypatch.setenv("KUMA_PUSH_HUEY_URL", PUSH_URL)
+    with mock.patch("urllib.request.urlopen") as urlopen:
+        notification_tasks.huey_heartbeat.call_local()
+    urlopen.assert_called_once()
