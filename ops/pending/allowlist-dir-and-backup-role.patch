+# The dumps and the ledger only read, so they log in as a read-only role
+# (pg_read_all_data): a compromised backup container must not be able to
+# write to or drop the database. docker-compose.yml falls back to the owner's
+# credentials while BACKUP_DB_USER is unset in .env; POSTGRES_USER here is
+# only the owner's name, passed so that fallback can be reported.
+DB_USER="${BACKUP_DB_USER:?BACKUP_DB_USER must be set}"
+export PGPASSWORD="${BACKUP_DB_PASSWORD:?BACKUP_DB_PASSWORD must be set}"
+if [ "$DB_USER" = "${POSTGRES_USER:-}" ]; then
+    echo "[$(date)] WARN: dumping as the database owner ${DB_USER}; set BACKUP_DB_USER and BACKUP_DB_PASSWORD in .env to the read-only backup role" >&2
+fi
 
 # GDPR: encryption passphrase (required)
 BACKUP_ENCRYPTION_KEY="${BACKUP_ENCRYPTION_KEY:?BACKUP_ENCRYPTION_KEY must be set}"
